# ─────────────────────────────────────────────────────────────
#  Toro Roso Studio — variables de entorno
#
#  · En Vercel: Project → Settings → Environment Variables.
#  · En tu computador: copia este archivo como `.env.local`.
#
#  Las variables que empiezan por VITE_ son PÚBLICAS (llegan al navegador).
#  Todas las demás son SECRETAS y solo las usa el servidor.
# ─────────────────────────────────────────────────────────────

# ── Públicas ─────────────────────────────────────────────────

# Opcional: el WhatsApp oficial (+57 322 493 5632) ya está en shared/business.ts.
# Úsala solo para cambiarlo sin tocar el código: formato internacional y SOLO dígitos.
VITE_WHATSAPP_NUMBER=

# Correo de contacto que se muestra en la web (opcional).
VITE_CONTACT_EMAIL=

# Dominio público, sin "/" al final. Ej.: https://www.tororosostudio.com
# Si se deja vacío en Vercel, se usa el dominio de producción del proyecto.
VITE_SITE_URL=

# ── Agenda (secretas) ────────────────────────────────────────

# Conexión a Postgres. Vercel la crea sola al conectar Neon desde Storage.
DATABASE_URL=

# Panel privado /admin: una sola cuenta (correo + contraseña de mínimo 10 caracteres).
# El panel no aparece en el menú del sitio; las clientas nunca necesitan cuenta.
ADMIN_EMAIL=

# También firma los enlaces "Confirmar / Rechazar" de los correos a Manuela.
ADMIN_PASSWORD=

# Opcional: texto largo y aleatorio para firmar la sesión del panel y esos enlaces.
ADMIN_SESSION_SECRET=

# Correo donde Manuela recibe cada solicitud y el resumen diario.
STUDIO_NOTIFY_EMAIL=

# Activa los recordatorios y el resumen diario (Vercel Cron). Texto aleatorio de 16+ caracteres.
CRON_SECRET=

# ── Correos automáticos: elige UNA opción ────────────────────

# Opción A · Gmail (sin dominio propio): usa una "contraseña de aplicación" de Google.
# Cuenta de envíos de Toro Roso Studio. Los correos salen como "Toro Roso Studio <tororosostudio@gmail.com>".
SMTP_USER=tororosostudio@gmail.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Opción B · Resend (requiere dominio verificado en resend.com).
RESEND_API_KEY=

# Remitente. Obligatorio con Resend; opcional con Gmail.
# Ej.: Toro Roso Studio <citas@tudominio.com>
EMAIL_FROM=

# ── Google Calendar de Manuela (opcional) ────────────────────
# Cuenta de servicio de Google Cloud con la que Manuela comparte su calendario
# ("Hacer cambios en los eventos"). Ver README → Google Calendar.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Copia la clave "private_key" del archivo JSON tal cual, con los \n incluidos.
GOOGLE_PRIVATE_KEY=

# ── WhatsApp automático (opcional, Meta WhatsApp Cloud API) ──
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Plantilla aprobada para "cita confirmada" y para el recordatorio del día anterior.
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CLOUD_REMINDER_TEMPLATE=
# WHATSAPP_CLOUD_TEMPLATE_LANG=es
# WHATSAPP_CLOUD_API_VERSION=v23.0
